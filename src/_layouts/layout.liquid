<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>{{ title }}</title>
  <style>
    body {
      margin: 0;
      font-family: Arial, sans-serif;
      background: #0f172a;
      color: #e5e7eb;
    }

    .layout {
      display: flex;
      min-height: 100vh;
    }

    aside {
      width: 260px;
      background: #020617;
      padding: 30px 20px;
      border-right: 1px solid #1e293b;
    }

    aside h2 {
      color: #22d3ee;
      margin-bottom: 30px;
    }

    aside a {
      display: block;
      color: #cbd5e1;
      text-decoration: none;
      margin: 14px 0;
      font-weight: bold;
    }

    aside a:hover {
      color: #22d3ee;
    }

    main {
      flex: 1;
      padding: 50px;
    }

    .hero {
      background: linear-gradient(135deg, #111827, #1e293b);
      padding: 45px;
      border-radius: 18px;
      box-shadow: 0 20px 40px rgba(0,0,0,0.35);
      margin-bottom: 30px;
    }

    h1 {
      color: #22d3ee;
      font-size: 48px;
      margin-top: 0;
    }

    h2 {
      color: #38bdf8;
    }

    li {
      margin: 8px 0;
    }

    .card {
      background: #1e293b;
      padding: 25px;
      border-radius: 14px;
      margin-top: 25px;
    }

    code {
      background: #020617;
      padding: 3px 6px;
      border-radius: 5px;
      color: #67e8f9;
    }
  </style>
</head>

<body>
  <div class="layout">
    <aside>
      <h2>CorpX Docs</h2>
      <a href="/ejemplo_git/">Home</a>
      <a href="/ejemplo_git/onboarding/">Onboarding</a>
      <a href="/ejemplo_git/troubleshooting/">Troubleshooting</a>
      <a href="/ejemplo_git/architecture/">Architecture</a>
    </aside>

    <main>
      <section class="hero">
        {{ content }}
      </section>
    </main>
  </div>
</body>
</html>